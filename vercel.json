{
    "buildCommand": "prisma generate && next build",
    "installCommand": "npm install",
    "framework": "nextjs",
    "crons": [
        {
            "path": "/api/cron/unpaid-members",
            "schedule": "0 8 * * *"
        },
        {
            "path": "/api/cron/split-payment-timeout",
            "schedule": "*/30 * * * *"
        }
    ]
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ========================================
    // users コレクション
    // ========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ========================================
    // studios コレクション
    // ========================================
    match /studios/{studioId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;  // 削除はAdmin SDKのみ
    }

    // ========================================
    // settings コレクション（プラン設定など）
    // ========================================
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ========================================
    // bookings コレクション
    // ========================================
    match /bookings/{bookingId} {
      allow read: if true;    // API経由でフィルタリング
      allow create: if true;  // API経由でバリデーション
      allow update: if true;  // API経由で権限チェック
      allow delete: if false;
    }

    // ========================================
    // payments コレクション
    // ========================================
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if false;  // Stripe Webhook（Admin SDK）のみ
    }

    // ========================================
    // campaigns コレクション
    // ========================================
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if false;  // Admin SDKのみ
    }

    // ========================================
    // coupons コレクション
    // ========================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;  // Admin SDKのみ
    }

    // ========================================
    // その他：デフォルト拒否
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

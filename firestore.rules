rules_version = '2';

// ============================================================
// 全コレクションをクライアントSDKから遮断（デフォルト拒否）
//
// 本アプリのデータアクセスはすべてNext.js APIルート経由の
// Firebase Admin SDK（ルールをバイパス）で行う設計に統一済み。
// - 認可はAPI層（__session / sg_uid クッキー + requirePlatformAdmin等）で実施
// - クライアントSDKの直接読み書きを許すと、APIのバリデーション・
//   認可チェックを迂回して全ユーザーの個人情報閲覧・改ざんが可能になるため全面拒否
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

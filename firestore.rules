rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ========================================
    // users コレクション
    // ========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;  // 削除はAdmin SDKのみ（セキュリティルール不要）
    }

    // ========================================
    // studios コレクション
    // ========================================
    match /studios/{studioId} {
      allow read: if true;
      allow create: if true;  // 店舗新規登録
      allow update: if true;  // 店舗情報更新
      allow delete: if true;  // 運営管理画面から削除可能
    }

    // ========================================
    // settings コレクション（プラン設定など）
    // ========================================
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;   // 運営管理画面から書き込み可
    }

    // ========================================
    // bookings コレクション
    // ========================================
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ========================================
    // payments コレクション
    // ========================================
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ========================================
    // campaigns コレクション
    // ========================================
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================
    // coupons コレクション
    // ========================================
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ========================================
    // その他：デフォルト拒否
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
